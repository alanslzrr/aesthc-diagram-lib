{
  "name": "@aesthc/diagram-lib",
  "version": "0.2.0",
  "description": "Reusable SVG diagram library — band, flowchart, sequence, state-machine, ER, timeline and swimlane layouts with a cohesive visual language (dot grid, hairline cards, cobalt/branch edges, glass tooltips).",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./canvas": {
      "types": "./dist/canvas/index.d.ts",
      "default": "./dist/canvas/index.js"
    },
    "./layouts": {
      "types": "./dist/layouts/index.d.ts",
      "default": "./dist/layouts/index.js"
    },
    "./layouts/band": {
      "types": "./dist/layouts/band.d.ts",
      "default": "./dist/layouts/band.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "default": "./dist/registry.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "default": "./dist/theme.js"
    },
    "./layout": {
      "types": "./dist/layout.d.ts",
      "default": "./dist/layout.js"
    },
    "./examples": {
      "types": "./dist/examples.d.ts",
      "default": "./dist/examples.js"
    },
    "./showcase": {
      "types": "./dist/showcase/index.d.ts",
      "default": "./dist/showcase/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:css": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify && node ./scripts/wrap-layer.mjs",
    "build": "tsup && node ./scripts/inject-use-client.mjs && pnpm build:css"
  },
  "keywords": [
    "diagram",
    "svg",
    "flowchart",
    "sequence",
    "state-machine",
    "er",
    "timeline",
    "swimlane"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-tooltip": "^1.2.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  },
  "author": "Alan Salazar",
  "repository": {
    "type": "git",
    "url": "https://github.com/alanslzrr/aesthc-diagram-lib.git"
  },
  "homepage": "https://github.com/alanslzrr/aesthc-diagram-lib#readme",
  "bugs": {
    "url": "https://github.com/alanslzrr/aesthc-diagram-lib/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "packageManager": "pnpm@10.29.3",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
