{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/DiagramSpec",
  "definitions": {
    "DiagramSpec": {
      "anyOf": [
        {
          "$ref": "#/definitions/BandDiagramSpec"
        },
        {
          "$ref": "#/definitions/FlowchartDiagramSpec"
        },
        {
          "$ref": "#/definitions/SequenceDiagramSpec"
        },
        {
          "$ref": "#/definitions/StateMachineDiagramSpec"
        },
        {
          "$ref": "#/definitions/ErDiagramSpec"
        },
        {
          "$ref": "#/definitions/TimelineDiagramSpec"
        },
        {
          "$ref": "#/definitions/SwimlaneDiagramSpec"
        }
      ]
    },
    "BandDiagramSpec": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "band"
        },
        "caption": {
          "type": "string"
        },
        "legend": {
          "type": "object",
          "properties": {
            "main": {
              "type": "string"
            },
            "branch": {
              "type": "string"
            }
          },
          "required": [
            "main",
            "branch"
          ],
          "additionalProperties": false
        },
        "bands": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DiagramBand"
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/BandDiagramNode"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DiagramEdge"
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DiagramDecision"
          }
        },
        "continuations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DiagramContinuation"
          }
        }
      },
      "required": [
        "type",
        "caption",
        "legend",
        "bands",
        "nodes",
        "edges"
      ],
      "additionalProperties": false,
      "description": "─── Per-type specs ───────────────────────────────────────────────────────"
    },
    "DiagramBand": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    },
    "BandDiagramNode": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "description": "Localized explanation shown on hover/focus and available to assistive technology."
        },
        "kind": {
          "type": "string",
          "description": "Mono micro-label above the title, e.g. 'Trigger', 'Engine', 'Gate'."
        },
        "sublabel": {
          "type": "string"
        },
        "weight": {
          "$ref": "#/definitions/NodeWeight"
        },
        "nudge": {
          "type": "number",
          "description": "Vertical fine-tune in viewBox units, applied after the layout centres the node."
        },
        "shape": {
          "$ref": "#/definitions/DiagramNodeShape",
          "description": "Draw this node as something other than a hairline card."
        },
        "textAnchor": {
          "$ref": "#/definitions/DiagramNodeTextAnchor",
          "description": "Label alignment for `event` shapes (timeline)."
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TableField"
          },
          "description": "ER table rows (only meaningful for `shape: 'table'`)."
        },
        "initial": {
          "type": "boolean",
          "description": "State-machine: draw a double outline (initial state)."
        },
        "final": {
          "type": "boolean",
          "description": "State-machine: draw a hollow centre (final state)."
        },
        "band": {
          "type": "number"
        }
      },
      "required": [
        "band",
        "description",
        "id",
        "label"
      ],
      "additionalProperties": false,
      "description": "Band-layout nodes additionally declare which column they belong to."
    },
    "NodeWeight": {
      "type": "string",
      "enum": [
        "primary",
        "secondary",
        "muted"
      ],
      "description": "Visual weight of a node card."
    },
    "DiagramNodeShape": {
      "type": "string",
      "enum": [
        "card",
        "state",
        "table",
        "event",
        "terminal",
        "bar"
      ],
      "description": "How a node is drawn: hairline card (default), state pill, ER table, timeline event, terminal, activation bar."
    },
    "DiagramNodeTextAnchor": {
      "type": "string",
      "enum": [
        "start",
        "end",
        "middle"
      ],
      "description": "For `event` shapes, where the label sits relative to the dot."
    },
    "TableField": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "description": "Optional column type, e.g. `uuid`, `varchar(64)`."
        },
        "key": {
          "type": "string",
          "enum": [
            "pk",
            "fk",
            "unique"
          ],
          "description": "Row badge: primary key / foreign key / unique."
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "description": "A single row in an ER table node."
    },
    "DiagramEdge": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable identity for parallel relations; recommended when editing/reordering."
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "variant": {
          "$ref": "#/definitions/EdgeVariant"
        },
        "dashed": {
          "type": "boolean"
        },
        "labelPlacement": {
          "$ref": "#/definitions/EdgeLabelPlacement",
          "description": "Move a pill into an authored whitespace slot without changing its edge."
        },
        "route": {
          "type": "object",
          "properties": {
            "lane": {
              "$ref": "#/definitions/EdgeLane"
            },
            "clearance": {
              "type": "number"
            }
          },
          "required": [
            "lane"
          ],
          "additionalProperties": false,
          "description": "Route a cross-band edge around every intervening band on an outer lane."
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "EdgeVariant": {
      "type": "string",
      "enum": [
        "main",
        "branch"
      ],
      "description": "Edge flavour: cobalt main path vs amber branch path."
    },
    "EdgeLabelPlacement": {
      "type": "string",
      "enum": [
        "above-target",
        "below-target",
        "left-of-edge",
        "right-of-edge"
      ]
    },
    "EdgeLane": {
      "type": "string",
      "enum": [
        "above",
        "below"
      ]
    },
    "DiagramDecision": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "source",
        "label"
      ],
      "additionalProperties": false,
      "description": "A compact authored question placed in the free run after a branching node."
    },
    "DiagramContinuation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "destination": {
          "type": "string"
        },
        "side": {
          "$ref": "#/definitions/ContinuationSide"
        },
        "anchor": {
          "$ref": "#/definitions/ContinuationAnchor"
        },
        "labelPlacement": {
          "type": "string",
          "enum": [
            "above-source",
            "below-source"
          ]
        },
        "variant": {
          "$ref": "#/definitions/EdgeVariant"
        },
        "ariaLabel": {
          "type": "string",
          "description": "Spoken text when the compact visible label needs clearer return semantics."
        }
      },
      "required": [
        "id",
        "from",
        "label",
        "destination",
        "side",
        "labelPlacement"
      ],
      "additionalProperties": false,
      "description": "A source-only, off-canvas continuation. It preserves return/feedback semantics without adding a long relation to the graph or enclosing the diagram in a rail."
    },
    "ContinuationSide": {
      "type": "string",
      "enum": [
        "left",
        "right"
      ]
    },
    "ContinuationAnchor": {
      "type": "string",
      "enum": [
        "upper",
        "center",
        "lower"
      ]
    },
    "FlowchartDiagramSpec": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "flowchart"
        },
        "caption": {
          "type": "string"
        },
        "legend": {
          "type": "object",
          "properties": {
            "main": {
              "type": "string"
            },
            "branch": {
              "type": "string"
            }
          },
          "required": [
            "main",
            "branch"
          ],
          "additionalProperties": false
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DiagramNode"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DiagramEdge"
          }
        },
        "level": {
          "type": "number",
          "description": "Global level override for every node; omit for automatic topological levels."
        },
        "direction": {
          "type": "string",
          "enum": [
            "top-down",
            "left-right"
          ],
          "description": "Main flow direction."
        }
      },
      "required": [
        "type",
        "caption",
        "legend",
        "nodes",
        "edges"
      ],
      "additionalProperties": false
    },
    "DiagramNode": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "description": "Localized explanation shown on hover/focus and available to assistive technology."
        },
        "kind": {
          "type": "string",
          "description": "Mono micro-label above the title, e.g. 'Trigger', 'Engine', 'Gate'."
        },
        "sublabel": {
          "type": "string"
        },
        "weight": {
          "$ref": "#/definitions/NodeWeight"
        },
        "nudge": {
          "type": "number",
          "description": "Vertical fine-tune in viewBox units, applied after the layout centres the node."
        },
        "shape": {
          "$ref": "#/definitions/DiagramNodeShape",
          "description": "Draw this node as something other than a hairline card."
        },
        "textAnchor": {
          "$ref": "#/definitions/DiagramNodeTextAnchor",
          "description": "Label alignment for `event` shapes (timeline)."
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TableField"
          },
          "description": "ER table rows (only meaningful for `shape: 'table'`)."
        },
        "initial": {
          "type": "boolean",
          "description": "State-machine: draw a double outline (initial state)."
        },
        "final": {
          "type": "boolean",
          "description": "State-machine: draw a hollow centre (final state)."
        }
      },
      "required": [
        "id",
        "label",
        "description"
      ],
      "additionalProperties": false
    },
    "SequenceDiagramSpec": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "sequence"
        },
        "caption": {
          "type": "string"
        },
        "legend": {
          "type": "object",
          "properties": {
            "main": {
              "type": "string"
            },
            "branch": {
              "type": "string"
            }
          },
          "required": [
            "main",
            "branch"
          ],
          "additionalProperties": false
        },
        "participants": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SequenceParticipant"
          }
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SequenceMessage"
          }
        }
      },
      "required": [
        "type",
        "caption",
        "legend",
        "participants",
        "messages"
      ],
      "additionalProperties": false
    },
    "SequenceParticipant": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false
    },
    "SequenceMessage": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "variant": {
          "$ref": "#/definitions/EdgeVariant"
        },
        "dashed": {
          "type": "boolean"
        },
        "activation": {
          "type": "boolean",
          "description": "Draw a thin activation bar on the target lifeline for this message."
        }
      },
      "required": [
        "id",
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "StateMachineDiagramSpec": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "state-machine"
        },
        "caption": {
          "type": "string"
        },
        "legend": {
          "type": "object",
          "properties": {
            "main": {
              "type": "string"
            },
            "branch": {
              "type": "string"
            }
          },
          "required": [
            "main",
            "branch"
          ],
          "additionalProperties": false
        },
        "states": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/StateMachineState"
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/StateTransition"
          }
        }
      },
      "required": [
        "type",
        "caption",
        "legend",
        "states",
        "transitions"
      ],
      "additionalProperties": false
    },
    "StateMachineState": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "sublabel": {
          "type": "string"
        },
        "weight": {
          "$ref": "#/definitions/NodeWeight"
        },
        "description": {
          "type": "string"
        },
        "initial": {
          "type": "boolean",
          "description": "Drawn with a double outline."
        },
        "final": {
          "type": "boolean",
          "description": "Drawn with a hollow centre."
        }
      },
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false
    },
    "StateTransition": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable identity for parallel relations; recommended when editing/reordering."
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "variant": {
          "$ref": "#/definitions/EdgeVariant"
        },
        "dashed": {
          "type": "boolean"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "ErDiagramSpec": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "er"
        },
        "caption": {
          "type": "string"
        },
        "legend": {
          "type": "object",
          "properties": {
            "main": {
              "type": "string"
            },
            "branch": {
              "type": "string"
            }
          },
          "required": [
            "main",
            "branch"
          ],
          "additionalProperties": false
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ErEntity"
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ErRelation"
          }
        }
      },
      "required": [
        "type",
        "caption",
        "legend",
        "entities",
        "relations"
      ],
      "additionalProperties": false
    },
    "ErEntity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "weight": {
          "$ref": "#/definitions/NodeWeight"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TableField"
          }
        }
      },
      "required": [
        "id",
        "label",
        "fields"
      ],
      "additionalProperties": false
    },
    "ErRelation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable identity for parallel relations; recommended when editing/reordering."
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "variant": {
          "$ref": "#/definitions/EdgeVariant"
        },
        "dashed": {
          "type": "boolean"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "TimelineDiagramSpec": {
      "type": "object",
