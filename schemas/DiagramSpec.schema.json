        },
        "caption": {
          "type": "string"
        },
        "legend": {
          "type": "object",
          "properties": {
            "main": {
              "type": "string"
            },
            "branch": {
              "type": "string"
            }
          },
          "required": [
            "main",
            "branch"
          ],
          "additionalProperties": false
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TimelineEvent"
          }
        }
      },
      "required": [
        "type",
        "caption",
        "legend",
        "events"
      ],
      "additionalProperties": false
    },
    "TimelineEvent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
