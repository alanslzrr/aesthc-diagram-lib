{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/TimelineDiagramSpec",
  "definitions": {
    "TimelineDiagramSpec": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "timeline"
        },
        "caption": {
          "type": "string"
        },
        "legend": {
          "type": "object",
          "properties": {
            "main": {
              "type": "string"
            },
            "branch": {
              "type": "string"
            }
          },
          "required": [
            "main",
            "branch"
          ],
          "additionalProperties": false
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TimelineEvent"
          }
        }
      },
      "required": [
        "type",
        "caption",
        "legend",
        "events"
      ],
      "additionalProperties": false
    },
    "TimelineEvent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "sublabel": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "variant": {
          "$ref": "#/definitions/EdgeVariant"
        },
        "weight": {
          "$ref": "#/definitions/NodeWeight"
        }
      },
      "required": [
        "id",
        "label",
        "description"
      ],
      "additionalProperties": false
    },
    "EdgeVariant": {
      "type": "string",
      "enum": [
        "main",
        "branch"
      ],
      "description": "Edge flavour: cobalt main path vs amber branch path."
    },
    "NodeWeight": {
      "type": "string",
      "enum": [
        "primary",
        "secondary",
        "muted"
      ],
      "description": "Visual weight of a node card."
    }
  }
}
