{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/ErDiagramSpec",
  "definitions": {
    "ErDiagramSpec": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "er"
        },
        "caption": {
          "type": "string"
        },
        "legend": {
          "type": "object",
          "properties": {
            "main": {
              "type": "string"
            },
            "branch": {
              "type": "string"
            }
          },
          "required": [
            "main",
            "branch"
          ],
          "additionalProperties": false
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ErEntity"
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ErRelation"
          }
        }
      },
      "required": [
        "type",
        "caption",
        "legend",
        "entities",
        "relations"
      ],
      "additionalProperties": false
    },
    "ErEntity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "weight": {
          "$ref": "#/definitions/NodeWeight"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TableField"
          }
        }
      },
      "required": [
        "id",
        "label",
        "fields"
      ],
      "additionalProperties": false
    },
    "NodeWeight": {
      "type": "string",
      "enum": [
        "primary",
        "secondary",
        "muted"
      ],
      "description": "Visual weight of a node card."
    },
    "TableField": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "description": "Optional column type, e.g. `uuid`, `varchar(64)`."
        },
        "key": {
          "type": "string",
          "enum": [
            "pk",
            "fk",
            "unique"
          ],
          "description": "Row badge: primary key / foreign key / unique."
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "description": "A single row in an ER table node."
    },
    "ErRelation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable identity for parallel relations; recommended when editing/reordering."
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "variant": {
          "$ref": "#/definitions/EdgeVariant"
        },
        "dashed": {
          "type": "boolean"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "EdgeVariant": {
      "type": "string",
      "enum": [
        "main",
        "branch"
      ],
      "description": "Edge flavour: cobalt main path vs amber branch path."
    }
  }
}
