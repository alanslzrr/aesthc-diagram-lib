{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/StateMachineDiagramSpec",
  "definitions": {
    "StateMachineDiagramSpec": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "state-machine"
        },
        "caption": {
          "type": "string"
        },
        "legend": {
          "type": "object",
          "properties": {
            "main": {
              "type": "string"
            },
            "branch": {
              "type": "string"
            }
          },
          "required": [
            "main",
            "branch"
          ],
          "additionalProperties": false
        },
        "states": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/StateMachineState"
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/StateTransition"
          }
        }
      },
      "required": [
        "type",
        "caption",
        "legend",
        "states",
        "transitions"
      ],
      "additionalProperties": false
    },
    "StateMachineState": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "sublabel": {
          "type": "string"
        },
        "weight": {
          "$ref": "#/definitions/NodeWeight"
        },
        "description": {
          "type": "string"
        },
        "initial": {
          "type": "boolean",
          "description": "Drawn with a double outline."
        },
        "final": {
          "type": "boolean",
          "description": "Drawn with a hollow centre."
        }
      },
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false
    },
    "NodeWeight": {
      "type": "string",
      "enum": [
        "primary",
        "secondary",
        "muted"
      ],
      "description": "Visual weight of a node card."
    },
    "StateTransition": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable identity for parallel relations; recommended when editing/reordering."
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "variant": {
          "$ref": "#/definitions/EdgeVariant"
        },
        "dashed": {
          "type": "boolean"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "EdgeVariant": {
      "type": "string",
      "enum": [
        "main",
        "branch"
      ],
      "description": "Edge flavour: cobalt main path vs amber branch path."
    }
  }
}
